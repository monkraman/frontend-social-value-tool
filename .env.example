# FastAPI Backend Base URL
VITE_API_URL=http://127.0.0.1:8000

# Local reference folder (optional, dev only). The Initiative Generator reads its pattern library,
# TOM measures and past responses from this folder on your own computer. Put the real path in
# .env.local (git-ignored). The documents are never copied into the repo, the build or the backend.
# SV_LOCAL_REPOSITORY=C:\path\to\Social Value reference folder
